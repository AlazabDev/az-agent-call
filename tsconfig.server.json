{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"outDir": "dist-server",
		"rootDir": ".",
		"types": ["node"],
		"baseUrl": ".",
        "paths": { 
           "@shared/*": ["shared/*"],
           "@agents/*": ["src/agents/*"],
           "@core/*": ["src/core/*"]
      }
	},
    "include": ["server/**/*.ts", "scripts/**/*.ts", "shared/**/*.ts", "src/agents/**/*.ts", "src/core/**/*.ts"],
    "exclude": ["src/**/*.tsx", "src/**/*.test.ts", "node_modules", "dist"]
}